# -*- coding: utf-8 -*-
"""Executable native NextAI operator acceptance inside the built NextCAD GUI."""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import sys
import traceback

import FreeCAD as App
import FreeCADGui as Gui

marker = Path(os.environ["NEXT3D_NEXTCAD_AI_ACCEPTANCE_MARKER"]).resolve()
project = Path(os.environ["NEXT3D_NEXTCAD_AI_ACCEPTANCE_PROJECT"]).resolve()
stage_project = Path(os.environ["NEXT3D_NEXTCAD_AI_ACCEPTANCE_STAGE_PROJECT"]).resolve()
module_root = Path(os.environ["NEXT3D_NEXTCAD_AI_MODULE_PATH"]).resolve()
sys.path.insert(0, str(module_root))

report = {
    "status": "FAIL",
    "application_version": ".".join(str(item) for item in App.Version()),
    "checks": {},
    "results": [],
}

def require(condition, message):
    if not condition:
        raise RuntimeError(message)

try:
    from next_ai import freecad_tools, tool_registry

    doc = App.newDocument("NextAI_NativeAcceptance")
    token = freecad_tools.begin_turn()
    allowed = {item["name"] for item in tool_registry.TOOLS}
    results = []
    trace_operations = []

    def run(steps):
        names = {step["tool"] for step in steps}
        result = tool_registry.execute_approved_plan(
            token, steps, allowed_tool_names=names
        )
        require(result.get("success") is True, "Typed native operation plan did not report success.")
        for step_result in result.get("results", []):
            results.append(step_result)
        trace_operations.extend(result.get("operations", []))
        return result.get("results", [])

    # Basic native Part solids and a true BRep boolean.
    created = run([
        {"tool": "create_part_box", "args": {
            "length": 20, "width": 20, "height": 10, "label": "Acceptance base block"
        }},
        {"tool": "create_part_box", "args": {
            "length": 10, "width": 10, "height": 10, "origin": [5, 5, 0],
            "label": "Acceptance cutter block"
        }},
    ])
    base_name = created[0]["created"]
    cutter_name = created[1]["created"]
    cut = run([{"tool": "boolean_operation", "args": {
        "operation": "cut", "object1": base_name, "object2": cutter_name,
        "label": "Acceptance boolean cut"
    }}])[0]
    cut_object = doc.getObject(cut["created"])
    require(cut_object is not None and cut_object.Shape.isValid(), "Native Part boolean cut is invalid.")
    require(abs(float(cut_object.Shape.Volume) - 3000.0) < 1e-4,
            f"Boolean cut volume mismatch: {cut_object.Shape.Volume}")
    report["checks"]["part_primitives_and_boolean"] = "PASS"

    # Transforms and copies preserve the source object and remain native objects.
    moved = run([{"tool": "transform_object", "args": {
        "object_name": base_name, "translate_x": 100, "relative": True
    }}])[0]
    base_object = doc.getObject(base_name)
    require(abs(float(base_object.Placement.Base.x) - 100.0) < 1e-6,
            "Native relative transform did not move the source object.")
    duplicate = run([{"tool": "duplicate_object", "args": {
        "object_name": cutter_name, "translate_y": 40, "label": "Acceptance independent copy"
    }}])[0]
    duplicate_object = doc.getObject(duplicate["created"])
    require(duplicate_object is not None and duplicate_object is not doc.getObject(cutter_name),
            "Native duplicate did not create an independent object.")
    require(abs(float(doc.getObject(cutter_name).Placement.Base.y)) < 1e-6,
            "Native duplicate changed the original object's placement.")
    report["checks"]["transform_and_duplicate"] = "PASS"

    # Real BRep fillet and chamfer on all edges of separate simple blocks.
    fillet = run([{"tool": "fillet_edges", "args": {
        "object_name": cutter_name, "edges": ["all"], "radius": 0.5,
        "label": "Acceptance fillet"
    }}])[0]
    fillet_object = doc.getObject(fillet["created"])
    require(fillet_object is not None and fillet_object.Shape.isValid()
            and len(fillet_object.Shape.Solids) == 1,
            "Native Part fillet did not produce one valid solid.")
    chamfer = run([{"tool": "chamfer_edges", "args": {
        "object_name": base_name, "edges": ["all"], "size": 0.25,
        "label": "Acceptance chamfer"
    }}])[0]
    chamfer_object = doc.getObject(chamfer["created"])
    require(chamfer_object is not None and chamfer_object.Shape.isValid()
            and len(chamfer_object.Shape.Solids) == 1,
            "Native Part chamfer did not produce one valid solid.")
    report["checks"]["part_fillet_and_chamfer"] = "PASS"

    # A genuinely editable Sketcher -> PartDesign -> native pattern workflow.
    run([{"tool": "create_partdesign_body", "args": {"name": "AcceptancePatternBody"}}])
    run([{"tool": "create_partdesign_sketch", "args": {
        "body_name": "AcceptancePatternBody", "name": "AcceptancePatternProfile",
        "plane": "XY_Plane"
    }}])
    run([{"tool": "add_sketch_polygon", "args": {
        "sketch_name": "AcceptancePatternProfile",
        "points": [[0, 0], [10, 0], [10, 10], [0, 10]]
    }}])
    pad = run([{"tool": "create_partdesign_pad", "args": {
        "body_name": "AcceptancePatternBody", "sketch_name": "AcceptancePatternProfile",
        "length": 10, "name": "AcceptancePad"
    }}])[0]
    body = doc.getObject("AcceptancePatternBody")
    require(body.Tip is not None and body.Tip.Name == pad["feature"],
            "PartDesign Pad did not become the Body tip.")
    require(body.Tip.Shape.isValid() and len(body.Tip.Shape.Solids) == 1,
            "PartDesign Pad is not one valid solid.")
    linear = run([{"tool": "linear_pattern", "args": {
        "feature_name": pad["feature"], "direction": "X", "length": 18,
        "occurrences": 3, "label": "Acceptance linear pattern"
    }}])[0]
    require(body.Tip.Name == linear["created"] and body.Tip.Shape.isValid()
            and len(body.Tip.Shape.Solids) == 1,
            "Native linear pattern did not become one valid Body solid.")
    report["checks"]["sketcher_partdesign_pad_and_linear_pattern"] = "PASS"

    # Save and reopen a complete first stage before continuing the larger design.
    stage_project.parent.mkdir(parents=True, exist_ok=True)
    doc.recompute()
    doc.saveAs(str(stage_project))
    stage_names = {obj.Name for obj in doc.Objects}
    App.closeDocument(doc.Name)
    doc = App.openDocument(str(stage_project))
    require(stage_names.issubset({obj.Name for obj in doc.Objects}),
            "Stage A native objects were lost after close/reopen.")
    token = freecad_tools.begin_turn()
    stage_summary = freecad_tools.inspect_document()
    stage_state_hash = freecad_tools._native_document_state_hash(doc)
    report["checks"]["native_stage_a_save_close_reopen"] = "PASS"
    stage_a_operations = [dict(item, sequence=index) for index, item in enumerate(trace_operations)]
    stage_a_checks = dict(report["checks"])

    # A circularly patterned spoke overlaps a hub, so the result is one valid solid.
    run([{"tool": "create_partdesign_body", "args": {"name": "AcceptancePolarBody"}}])
    run([{"tool": "create_partdesign_sketch", "args": {
        "body_name": "AcceptancePolarBody", "name": "AcceptancePolarHubProfile",
        "plane": "XY_Plane"
    }}])
    run([{"tool": "add_sketch_circle", "args": {
        "sketch_name": "AcceptancePolarHubProfile", "center": [0, 0], "radius": 5
    }}])
    run([{"tool": "create_partdesign_pad", "args": {
        "body_name": "AcceptancePolarBody", "sketch_name": "AcceptancePolarHubProfile",
        "length": 8, "name": "AcceptancePolarHub"
    }}])
    run([{"tool": "create_partdesign_sketch", "args": {
        "body_name": "AcceptancePolarBody", "name": "AcceptancePolarSpokeProfile",
        "plane": "XY_Plane"
    }}])
    run([{"tool": "add_sketch_polygon", "args": {
        "sketch_name": "AcceptancePolarSpokeProfile",
        "points": [[4, -2], [12, -2], [12, 2], [4, 2]]
    }}])
    polar_pad = run([{"tool": "create_partdesign_pad", "args": {
        "body_name": "AcceptancePolarBody", "sketch_name": "AcceptancePolarSpokeProfile",
        "length": 8, "name": "AcceptancePolarSpokePad"
    }}])[0]
    polar = run([{"tool": "polar_pattern", "args": {
        "feature_name": polar_pad["feature"], "axis": "Z",
        "angle": 360, "occurrences": 4, "label": "Acceptance polar pattern"
    }}])[0]
    polar_body = doc.getObject("AcceptancePolarBody")
    require(polar_body.Tip.Name == polar["created"] and polar_body.Tip.Shape.isValid()
            and len(polar_body.Tip.Shape.Solids) == 1,
            "Native polar pattern did not become one valid Body solid.")
    report["checks"]["partdesign_polar_pattern_with_hub"] = "PASS"

    # Native Spreadsheet generated from actual object geometry and properties.
    names_for_schedule = [
        base_name, cutter_name, cut["created"], duplicate["created"],
        fillet["created"], chamfer["created"], "AcceptancePatternBody",
        "AcceptancePolarBody"
    ]
    schedule = run([{"tool": "create_model_schedule", "args": {
        "name": "AcceptanceModelSchedule",
        "object_names": names_for_schedule
    }}])[0]
    sheet = doc.getObject(schedule["schedule"])
    require(sheet is not None and sheet.TypeId == "Spreadsheet::Sheet",
            "Model schedule is not a native Spreadsheet.")
    require(int(schedule["row_count"]) == len(names_for_schedule),
            "Model schedule row count does not match selected native objects.")
    require(str(sheet.get("A1")) == "Mark" and str(sheet.get("B2")) == base_name,
            "Model schedule did not preserve native model object identity.")
    report["checks"]["native_spreadsheet_schedule"] = "PASS"

    # Save, close and reopen the exact native project and re-check model integrity.
    doc.recompute()
    require(all(not any(x in list(getattr(obj, "State", []) or []) for x in ("Invalid", "Error"))
                for obj in doc.Objects),
            "A native model object is in an Invalid/Error state before save.")
    project.parent.mkdir(parents=True, exist_ok=True)
    doc.saveAs(str(project))
    saved_names = {obj.Name for obj in doc.Objects}
    App.closeDocument(doc.Name)
    reopened = App.openDocument(str(project))
    require(saved_names.issubset({obj.Name for obj in reopened.Objects}),
            "One or more native model objects were lost on reopen.")
    require(reopened.getObject("AcceptanceModelSchedule") is not None,
            "Native Spreadsheet schedule did not survive reopen.")
    require(reopened.getObject("AcceptancePatternBody").Tip.Shape.isValid(),
            "PartDesign pattern Body is invalid after reopen.")
    require(reopened.getObject("AcceptancePolarBody").Tip.Shape.isValid(),
            "PartDesign polar Body is invalid after reopen.")
    require(abs(float(reopened.getObject(cut["created"]).Shape.Volume) - 3000.0) < 1e-4,
            "Boolean result volume changed after reopen.")
    report["checks"]["native_save_close_reopen"] = "PASS"

    def sha256_file(path):
        digest = hashlib.sha256()
        with open(path, "rb") as handle:
            for block in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(block)
        return digest.hexdigest()

    def build_training_record(record_id, prompt, operations, before_state, after_summary,
                              after_state_hash, artifact_path, checks, parameters):
        artifact_hash = sha256_file(artifact_path)
        return {
            "schema_version": "1.0.0",
            "record_id": record_id,
            "application": "nextcad",
            "application_version": report["application_version"],
            "adapter_schema_version": tool_registry.TOOL_SCHEMA_VERSION,
            "task": {
                "prompt": prompt,
                "task_type": "create",
                "discipline": ["CAD", "parametric mechanical design"],
                "language": "en",
                "reference_questions": [],
                "design_rationale": "Synthetic automated native-adapter acceptance; not a functional engineering design.",
            },
            "specification": {
                "parameters": parameters,
                "constraints": ["All modelled lengths are millimetres.", "Patterned bodies must be one valid solid."],
                "assumptions": ["No material, load, tolerance, manufacturing or statutory design claim is made."],
                "unresolved_questions": [],
            },
            "native_states": {
                "before": before_state,
                "after": {
                    "format": "FCStd",
                    "uri": artifact_path.name,
                    "sha256": artifact_hash,
                    "state_summary": after_summary,
                    "application_revision": os.environ.get("NEXT3D_NEXTCAD_SOURCE_COMMIT"),
                },
            },
            "operations": operations,
            "validation": {
                "overall": "passed",
                "checks": [
                    {
                        "check_id": check_id,
                        "status": "pass",
                        "summary": str(status),
                        "expected": True,
                        "actual": True,
                        "unit": None,
                        "tolerance": None,
                        "evidence": "Native NextCAD GUI acceptance assertion",
                    }
                    for check_id, status in sorted(checks.items())
                ],
                "engine_report": {
                    "application": "NextCAD",
                    "application_version": report["application_version"],
                    "native_test_fixture": True,
                    "independent_engineering_validation": "not_claimed",
                },
                "round_trip_passed": True,
                "recompute_passed": True,
                "parametric_perturbation_passed": None,
            },
            "artifacts": [{
                "kind": "other",
                "uri": artifact_path.name,
                "sha256": artifact_hash,
                "native_state_hash": after_state_hash,
                "description": "Native FCStd file from a staged NextAI acceptance run.",
            }],
            "source": {
                "source_type": "synthetic",
                "source_id": "nextcad-native-acceptance:" + os.environ.get("NEXT3D_NEXTCAD_SOURCE_COMMIT", "pinned-source"),
                "author_or_owner": "Next3D",
                "license": "project-authored",
                "permission_status": "not_required",
                "terms_reviewed": True,
                "attribution": "Generated by the Next3D native integration acceptance suite.",
                "withdrawal_key": "nextcad-native-acceptance",
            },
            "privacy": {
                "user_consent": False,
                "contains_personal_data": False,
                "public_release_allowed": True,
                "redaction_status": "not_needed",
            },
            "split": "test",
        }

    after_summary = freecad_tools.inspect_document()
    after_state_hash = freecad_tools._native_document_state_hash(reopened)
    stage_after = {
        "format": "FCStd",
        "uri": stage_project.name,
        "sha256": sha256_file(stage_project),
        "state_summary": stage_summary,
        "application_revision": os.environ.get("NEXT3D_NEXTCAD_SOURCE_COMMIT"),
    }
    final_operations = [dict(item, sequence=index)
                        for index, item in enumerate(trace_operations[len(stage_a_operations):])]
    require(len(stage_a_operations) <= 20 and len(final_operations) <= 20,
            "Native acceptance training plan exceeds the NextAI 20-step runtime limit.")
    require(len(trace_operations) > 0, "Native acceptance trace contains no native operations.")
    require(all(item.get("status") == "applied" for item in trace_operations),
            "Native acceptance trace contains an operation that did not apply.")
    require(all(item.get("tool_schema_version") == tool_registry.TOOL_SCHEMA_VERSION
                for item in trace_operations),
            "Native acceptance trace is missing the tool schema version.")
    training_records = [
        build_training_record(
            "nextcad-stage-a-" + stage_after["sha256"][:16],
            "Create Part primitives, subtract a boolean cutter, move and duplicate native objects, then apply native fillet and chamfer operations.",
            stage_a_operations,
            None,
            stage_summary,
            stage_state_hash,
            stage_project,
            stage_a_checks,
            [
                {"name": "base_length", "value": 20, "unit": "mm", "description": "Base block X dimension", "origin": "derived", "confirmed": True},
                {"name": "base_width", "value": 20, "unit": "mm", "description": "Base block Y dimension", "origin": "derived", "confirmed": True},
                {"name": "base_height", "value": 10, "unit": "mm", "description": "Base block Z dimension", "origin": "derived", "confirmed": True},
                {"name": "cutter_length", "value": 10, "unit": "mm", "description": "Boolean cutter X dimension", "origin": "derived", "confirmed": True},
                {"name": "cutter_width", "value": 10, "unit": "mm", "description": "Boolean cutter Y dimension", "origin": "derived", "confirmed": True},
                {"name": "cutter_height", "value": 10, "unit": "mm", "description": "Boolean cutter Z dimension", "origin": "derived", "confirmed": True},
                {"name": "cutter_offset_x", "value": 5, "unit": "mm", "description": "Boolean cutter X offset", "origin": "derived", "confirmed": True},
                {"name": "cutter_offset_y", "value": 5, "unit": "mm", "description": "Boolean cutter Y offset", "origin": "derived", "confirmed": True},
                {"name": "base_translate_x", "value": 100, "unit": "mm", "description": "Relative X move of the base object", "origin": "derived", "confirmed": True},
                {"name": "duplicate_translate_y", "value": 40, "unit": "mm", "description": "Duplicate Y offset", "origin": "derived", "confirmed": True},
                {"name": "fillet_radius", "value": 0.5, "unit": "mm", "description": "Native edge fillet radius", "origin": "derived", "confirmed": True},
                {"name": "chamfer_size", "value": 0.25, "unit": "mm", "description": "Native edge chamfer size", "origin": "derived", "confirmed": True},
            ],
        ),
        build_training_record(
            "nextcad-stage-b-" + sha256_file(project)[:16],
            "Continue the saved CAD document by creating constrained PartDesign profiles and pads, applying linear and circular patterns, and generating a model-derived Spreadsheet schedule.",
            final_operations,
            dict(stage_after),
            after_summary,
            after_state_hash,
            project,
            report["checks"],
            [
                {"name": "hub_radius", "value": 5, "unit": "mm", "description": "Central hub radius", "origin": "derived", "confirmed": True},
                {"name": "hub_pad_depth", "value": 8, "unit": "mm", "description": "Hub extrusion depth", "origin": "derived", "confirmed": True},
                {"name": "spoke_inner_x", "value": 4, "unit": "mm", "description": "Spoke inner boundary overlapping the hub", "origin": "derived", "confirmed": True},
                {"name": "spoke_outer_x", "value": 12, "unit": "mm", "description": "Spoke outer boundary", "origin": "derived", "confirmed": True},
                {"name": "spoke_half_width", "value": 2, "unit": "mm", "description": "Half-width of the spoke profile", "origin": "derived", "confirmed": True},
                {"name": "spoke_pad_depth", "value": 8, "unit": "mm", "description": "Spoke extrusion depth", "origin": "derived", "confirmed": True},
                {"name": "polar_axis", "value": "Z", "unit": "axis", "description": "Circular pattern axis", "origin": "derived", "confirmed": True},
                {"name": "polar_angle", "value": 360, "unit": "degree", "description": "Circular pattern total angle", "origin": "derived", "confirmed": True},
                {"name": "polar_occurrences", "value": 4, "unit": "count", "description": "Circular pattern occurrence count", "origin": "derived", "confirmed": True},
                {"name": "schedule_component_count", "value": 8, "unit": "count", "description": "Number of native objects in the model schedule", "origin": "derived", "confirmed": True},
            ],
        ),
    ]
    trace_path = marker.with_name("nextcad-ai-native-acceptance-trace.jsonl")
    trace_path.write_text(
        "".join(json.dumps(record, ensure_ascii=False) + "\n" for record in training_records),
        encoding="utf-8",
    )
    report["status"] = "PASS"
    report["native_object_count"] = len(reopened.Objects)
    report["schedule_rows"] = len(names_for_schedule)
    report["project_file"] = str(project)
    report["stage_project_file"] = str(stage_project)
    report["operation_results"] = results
    report["training_trace"] = {
        "path": str(trace_path),
        "records": len(training_records),
        "split": "test",
        "operation_records": len(trace_operations),
        "evidence_level": "L3 native execution + L4 save/reopen",
        "independent_engineering_validation": "not_claimed",
    }
except Exception as exc:
    report["status"] = "FAIL"
    report["error"] = str(exc)
    report["traceback"] = traceback.format_exc()
finally:
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print("NEXTAI NATIVE ACCEPTANCE " + report["status"] + ": " + str(marker))
