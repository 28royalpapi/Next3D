  "split": "test",
  "evidence_policy": {
    "L0": "Authored question/rubric only; no evidence of execution.",
    "L1": "Command/schema compatibility checked.",
    "L2": "Ordered plan checked.",
    "L3": "Execution in the actual pinned native app.",
    "L4": "Save/close/reopen and state comparison.",
    "L5": "Independent domain-specific validation."
  },
