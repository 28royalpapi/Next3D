+    nextAiHeading->setFont(nextAiFont);
+    nextAiLayout->addWidget(nextAiHeading);
+    auto nextAiDescription = new QLabel(
+        QObject::tr("Your dedicated AI workspace. Ask for help with CAD tools and design tasks."),
+        nextAiContent);
+    nextAiDescription->setWordWrap(true);
+    nextAiLayout->addWidget(nextAiDescription);
+    nextAiLayout->addStretch(1);
