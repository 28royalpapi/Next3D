{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://next3d.dev/schemas/next-ai-action-plan.v1.schema.json",
  "title": "Next AI Native Action Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "application",
    "application_version",
    "document",
    "request",
    "summary",
    "assumptions",
    "open_questions",
    "steps",
    "validation_requirements",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "application": {
      "enum": [
        "nextcad",
        "nextbim"
      ]
    },
    "application_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "native_format",
        "state_hash"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "native_format": {
          "enum": [
            "FCStd",
            "BIMC",
            "BIMT",
            "other"
          ]
        },
        "state_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_workbench_or_discipline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "purpose",
          "tool",
          "tool_schema_version",
          "arguments",
          "risk",
          "confirmation",
          "preconditions",
          "postconditions",
          "undoable",
          "failure_policy"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "tool_schema_version": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "risk": {
            "enum": [
              "read_only",
              "reversible_change",
              "project_change",
              "external_effect",
              "engineering_analysis"
            ]
          },
          "confirmation": {
            "enum": [
              "none",
              "before_step",
              "before_plan_execution"
            ]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "undoable": {
            "type": "boolean"
          },
          "failure_policy": {
            "enum": [
              "rollback_and_stop",
              "stop_without_mutation",
              "continue_with_warning"
            ]
          },
          "expected_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_runtime_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "draft",
        "needs_clarification",
        "awaiting_confirmation",
        "approved",
        "executing",
        "completed",
        "rejected",
        "failed"
      ]
    },
    "approved_by_user": {
      "type": "boolean"
    },
    "approval_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
